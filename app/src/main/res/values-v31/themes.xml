<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31+) SplashScreen Theme -->
    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <!-- Android 12+ SplashScreen: Eski logo kaldırıldı, şeffaf geçiş ile Compose SplashScreen animasyonu devreye girer -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_transparent</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
</resources>
